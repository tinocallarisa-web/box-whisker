{
  "dataRoles": [
    {
      "name": "category",
      "kind": "Grouping",
      "displayName": "Category",
      "displayNameKey": "Role_category",
      "description": "One box per value. A hierarchy gives drilldown.",
      "descriptionKey": "Role_category_Desc"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value",
      "displayNameKey": "Role_value",
      "description": "The measure whose distribution is drawn, evaluated per Detail row.",
      "descriptionKey": "Role_value_Desc"
    },
    {
      "name": "detail",
      "kind": "Grouping",
      "displayName": "Detail (rows)",
      "displayNameKey": "Role_detail",
      "description": "The ID of each observation: order, employee, ticket. Without it there is no distribution.",
      "descriptionKey": "Role_detail_Desc"
    },
    {
      "name": "group",
      "kind": "Grouping",
      "displayName": "Group (Pro)",
      "displayNameKey": "Role_group",
      "description": "Side-by-side boxes within each category, with a legend.",
      "descriptionKey": "Role_group_Desc"
    },
    {
      "name": "panel",
      "kind": "Grouping",
      "displayName": "Small multiples (Pro)",
      "displayNameKey": "Role_panel",
      "description": "One panel per value, on a shared scale.",
      "descriptionKey": "Role_panel_Desc"
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "displayNameKey": "Role_tooltips",
      "description": "Extra values in the tooltip.",
      "descriptionKey": "Role_tooltips_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "value": {
            "max": 1
          },
          "detail": {
            "max": 1
          },
          "group": {
            "max": 1
          },
          "panel": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "category"
              }
            },
            {
              "bind": {
                "to": "group"
              }
            },
            {
              "bind": {
                "to": "panel"
              }
            },
            {
              "bind": {
                "to": "detail"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
